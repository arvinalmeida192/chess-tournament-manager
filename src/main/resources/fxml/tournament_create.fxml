<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chess.tournament.ui.tournament.TournamentCreateController"
      spacing="12" prefWidth="460">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label text="Create Tournament" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="140" prefWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="220"/>
        </columnConstraints>

        <Label text="Name *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField" promptText="Tournament name" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Type *" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="typeCombo" GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity"/>

        <Label text="Rounds *" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Spinner fx:id="roundsSpinner" editable="true" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Qualifiers *" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Spinner fx:id="qualifiersSpinner" editable="true" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label fx:id="swissMethodLabel" text="Swiss first round" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <ComboBox fx:id="swissMethodCombo" GridPane.columnIndex="1" GridPane.rowIndex="4" maxWidth="Infinity"/>
    </GridPane>

    <Label fx:id="hintLabel" wrapText="true" style="-fx-text-fill: #555555;"/>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel"/>
        <Button fx:id="saveButton" text="Create" defaultButton="true" onAction="#onSave"/>
    </HBox>
</VBox>
