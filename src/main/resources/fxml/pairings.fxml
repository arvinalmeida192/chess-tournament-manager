<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chess.tournament.ui.tournament.PairingsController"
            prefWidth="740" prefHeight="500"
            styleClass="dialog-root">
    <top>
        <VBox spacing="6" styleClass="page-header">
            <padding>
                <Insets top="16" right="16" bottom="8" left="16"/>
            </padding>
            <Label fx:id="titleLabel" text="Pairings" styleClass="section-title"/>
            <Label fx:id="roundLabel" styleClass="muted-label"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="8">
            <padding>
                <Insets top="4" right="16" bottom="8" left="16"/>
            </padding>
            <TableView fx:id="pairingsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="boardColumn" text="Board" prefWidth="70"/>
                    <TableColumn fx:id="whiteColumn" text="White" prefWidth="230"/>
                    <TableColumn fx:id="blackColumn" text="Black" prefWidth="230"/>
                    <TableColumn fx:id="resultColumn" text="Result" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="0" right="16" bottom="16" left="16"/>
            </padding>
            <Label fx:id="statusLabel" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="muted-label"/>
            <Button fx:id="generateButton" text="Generate &amp; Publish" onAction="#onGenerate"
                    styleClass="primary-button"/>
            <Button fx:id="refreshButton" text="Refresh" onAction="#onRefresh" styleClass="secondary-button"/>
            <Button text="Close" onAction="#onClose" styleClass="secondary-button"/>
        </HBox>
    </bottom>
</BorderPane>
