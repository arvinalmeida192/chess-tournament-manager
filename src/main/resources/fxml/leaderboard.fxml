<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chess.tournament.ui.tournament.LeaderboardController"
            prefWidth="900" prefHeight="560">
    <top>
        <VBox spacing="8">
            <padding>
                <Insets top="12" right="12" bottom="8" left="12"/>
            </padding>
            <Label fx:id="titleLabel" text="Leaderboard">
                <font>
                    <Font name="System Bold" size="18"/>
                </font>
            </Label>
            <Label fx:id="headerLabel" text="Round — Leaderboard"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Round:"/>
                <ComboBox fx:id="roundCombo" prefWidth="120"/>
                <Button fx:id="refreshButton" text="Refresh" onAction="#onRefresh"/>
                <Button fx:id="qualifyButton" text="Apply Qualification" onAction="#onApplyQualification"/>
                <Button fx:id="finalizeButton" text="Finalize Tournament" onAction="#onFinalize"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="8">
            <padding>
                <Insets top="4" right="12" bottom="8" left="12"/>
            </padding>
            <TableView fx:id="standingsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="rankColumn" text="Rank" prefWidth="60"/>
                    <TableColumn fx:id="playerColumn" text="Player" prefWidth="180"/>
                    <TableColumn fx:id="ratingColumn" text="Rating" prefWidth="80"/>
                    <TableColumn fx:id="pointsColumn" text="Points" prefWidth="70"/>
                    <TableColumn fx:id="winsColumn" text="W" prefWidth="50"/>
                    <TableColumn fx:id="drawsColumn" text="D" prefWidth="50"/>
                    <TableColumn fx:id="lossesColumn" text="L" prefWidth="50"/>
                    <TableColumn fx:id="startRatingColumn" text="Start Rating" prefWidth="100"/>
                    <TableColumn fx:id="finalRatingColumn" text="Final Rating" prefWidth="100"/>
                    <TableColumn fx:id="qualificationColumn" text="Qualification" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="0" right="12" bottom="12" left="12"/>
            </padding>
            <Label fx:id="statusLabel" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Close" onAction="#onClose"/>
        </HBox>
    </bottom>
</BorderPane>
