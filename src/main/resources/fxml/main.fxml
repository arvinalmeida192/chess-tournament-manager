<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chess.tournament.ui.MainController"
            prefWidth="1080" prefHeight="720">
    <top>
        <VBox>
            <MenuBar>
                <Menu text="File">
                    <MenuItem text="Home" onAction="#onHome"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Exit" onAction="#onExit"/>
                </Menu>
                <Menu text="Players">
                    <MenuItem text="Manage Players" onAction="#onPlayers"/>
                </Menu>
                <Menu text="Tournaments">
                    <MenuItem text="Manage Tournaments" onAction="#onTournaments"/>
                </Menu>
                <Menu text="Settings">
                    <MenuItem text="Test Database Connection" onAction="#onTestConnection"/>
                </Menu>
            </MenuBar>
            <ToolBar>
                <Button text="Home" onAction="#onHome" styleClass="secondary-button"/>
                <Button text="Players" onAction="#onPlayers"/>
                <Button text="Tournaments" onAction="#onTournaments" styleClass="primary-button"/>
            </ToolBar>
        </VBox>
    </top>
    <center>
        <StackPane fx:id="contentPane">
            <VBox fx:id="homePane" alignment="CENTER" spacing="16">
                <padding>
                    <Insets top="48" right="48" bottom="48" left="48"/>
                </padding>
                <Label text="Chess Tournament Manager" styleClass="home-title"/>
                <Label text="Create tournaments, enroll players, generate pairings, record results, and finalize standings."
                       wrapText="true"
                       styleClass="home-subtitle"/>
                <HBox spacing="12" alignment="CENTER" styleClass="home-actions">
                    <Button text="Manage Players" onAction="#onPlayers"/>
                    <Button text="Manage Tournaments" onAction="#onTournaments" styleClass="primary-button"/>
                </HBox>
                <Label fx:id="statusLabel" text="Checking database connection..."
                       wrapText="true"
                       styleClass="muted-label"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
